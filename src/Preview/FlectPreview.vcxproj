<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{5C3B6F7E-0B57-4D9E-9D1C-4D1E8A6F2B90}</ProjectGuid>
    <RootNamespace>FlectPreview</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset Condition="'$(DefaultPlatformToolset)' != ''">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' != 'Debug'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)' == 'Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(BrandBuildDir)preview\$(Configuration)\</OutDir>
    <IntDir>$(BrandBuildDir)preview\obj\$(Configuration)\</IntDir>
    <TargetName>$(BrandPreviewDllName)</TargetName>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;STRICT;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(IntDir);$(BrandThirdPartyDir)webview2\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
      <FunctionLevelLinking Condition="'$(Configuration)' == 'Release'">true</FunctionLevelLinking>
      <IntrinsicFunctions Condition="'$(Configuration)' == 'Release'">true</IntrinsicFunctions>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>FlectPreview.def</ModuleDefinitionFile>
      <AdditionalDependencies>$(BrandThirdPartyDir)webview2\x64\WebView2LoaderStatic.lib;shlwapi.lib;shell32.lib;ole32.lib;oleaut32.lib;uuid.lib;advapi32.lib;user32.lib;gdi32.lib;version.lib;urlmon.lib;bcrypt.lib;pathcch.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding Condition="'$(Configuration)' == 'Release'">true</EnableCOMDATFolding>
      <OptimizeReferences Condition="'$(Configuration)' == 'Release'">true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Config.cpp" />
    <ClCompile Include="Context.cpp" />
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="Kinds.cpp" />
    <ClCompile Include="Media.cpp" />
    <ClCompile Include="PreviewHandler.cpp" />
    <ClCompile Include="Registry.cpp" />
    <ClCompile Include="ResourceServer.cpp" />
    <ClCompile Include="Session.cpp" />
    <ClCompile Include="Sniff.cpp" />
    <ClCompile Include="Text.cpp" />
    <ClCompile Include="Trust.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="Config.h" />
    <ClInclude Include="Context.h" />
    <ClInclude Include="framework.h" />
    <ClInclude Include="Kinds.h" />
    <ClInclude Include="Media.h" />
    <ClInclude Include="Module.h" />
    <ClInclude Include="PreviewHandler.h" />
    <ClInclude Include="Registry.h" />
    <ClInclude Include="ResourceServer.h" />
    <ClInclude Include="Session.h" />
    <ClInclude Include="Sniff.h" />
    <ClInclude Include="Text.h" />
    <ClInclude Include="Trust.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Extensions.inc" />
    <None Include="FlectPreview.def" />
  </ItemGroup>

  <Target Name="GenerateBrandingHeader"
          BeforeTargets="ClCompile"
          Inputs="$(RepoRoot)Directory.Build.props;$(MSBuildThisFileFullPath)"
          Outputs="$(IntDir)Branding.g.h">
    <MakeDir Directories="$(IntDir)" />
    <ItemGroup>
      <_BrandLine Remove="@(_BrandLine)" />
      <_BrandLine Include="#pragma once" />
      <_BrandLine Include="#define BRAND_NAME L&quot;$(BrandName)&quot;" />
      <_BrandLine Include="#define BRAND_PREVIEW_CLSID_STR L&quot;$(BrandPreviewClsid)&quot;" />
      <_BrandLine Include="#define BRAND_PREVIEW_APPID_STR L&quot;$(BrandPreviewAppId)&quot;" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntDir)Branding.g.h"
                      Lines="@(_BrandLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="utf-8" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
