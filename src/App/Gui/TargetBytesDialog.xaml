<Window x:Class="Optimizer.Gui.TargetBytesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Text.Heading}" Text="Compress" />
    <TextBlock x:Name="HintText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
               Margin="0,0,0,14" />

    <TextBlock Text="Target size" Margin="0,0,0,4" />
    <TextBox x:Name="SizeBox" TextChanged="OnInputChanged" />
    <TextBlock x:Name="EchoText" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="Compress" IsDefault="True" Style="{StaticResource Button.Primary}"
              Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
