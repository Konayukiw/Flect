<Window x:Class="Optimizer.Gui.Trim"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Optimizer.Main"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Closed="OnClosed">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Text.Heading}" Text="{loc:T dialog.trim.title}" />
    <TextBlock x:Name="HintText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
               Margin="0,0,0,14" />

    <!-- Preview is a bonus: MediaElement plays what Windows has codecs for, and the whole
         block is collapsed when it cannot open the file. The scrubber below works either way,
         because the duration comes from ffprobe rather than from the player. -->
    <Border x:Name="PreviewPanel" Style="{StaticResource Panel.Card}" Padding="0"
            Margin="0,0,0,12" ClipToBounds="True">
      <MediaElement x:Name="Player" Height="280" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                    ScrubbingEnabled="True" Stretch="Uniform"
                    MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed"
                    MediaEnded="OnMediaEnded" />
    </Border>

    <Slider x:Name="Scrubber" Minimum="0" Maximum="1" Value="0"
            ValueChanged="OnScrubberChanged" />

    <Grid Margin="0,6,0,0">
      <TextBlock x:Name="PositionText" Style="{StaticResource Text.Muted}"
                 HorizontalAlignment="Left" />
      <TextBlock x:Name="DurationText" Style="{StaticResource Text.Muted}"
                 HorizontalAlignment="Right" />
    </Grid>

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="PlayButton" Content="{loc:T dialog.trim.play}" Width="96" Click="OnPlayPause" />
      <Button Content="{loc:T dialog.trim.setStart}" Margin="8,0,0,0" Click="OnSetStart" />
      <Button Content="{loc:T dialog.trim.setEnd}" Margin="8,0,0,0" Click="OnSetEnd" />
    </StackPanel>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{loc:T dialog.trim.start}" Margin="0,0,0,4" />
        <TextBox x:Name="StartBox" TextChanged="OnTimesChanged" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{loc:T dialog.trim.end}" Margin="0,0,0,4" />
        <TextBox x:Name="EndBox" TextChanged="OnTimesChanged" />
      </StackPanel>
    </Grid>

    <TextBlock x:Name="SelectionText" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{loc:T common.cancel}" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="{loc:T dialog.trim.action}" IsDefault="True"
              Style="{StaticResource Button.Primary}" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
