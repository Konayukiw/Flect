<Window x:Class="Optimizer.Gui.PdfPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="780" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="14,10" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <Grid>
        <TextBlock x:Name="NameText" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,220,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PreviousButton" Content="&#x2039;" MinWidth="40" Padding="8,4"
                  Click="OnPrevious" />
          <TextBlock x:Name="PageText" VerticalAlignment="Center" MinWidth="96"
                     TextAlignment="Center" Style="{StaticResource Text.Muted}" />
          <Button x:Name="NextButton" Content="&#x203A;" MinWidth="40" Padding="8,4"
                  Click="OnNext" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" x:Name="Scroller" Padding="16"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Image x:Name="PageImage" Stretch="Uniform" StretchDirection="DownOnly"
             HorizontalAlignment="Center" VerticalAlignment="Top"
             RenderOptions.BitmapScalingMode="HighQuality" />
    </ScrollViewer>
  </Grid>
</Window>
