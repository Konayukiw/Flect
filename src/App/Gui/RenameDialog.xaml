<Window x:Class="Optimizer.Gui.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Text.Heading}" Text="Rename" />
    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="Files directly inside each selected folder are renamed, one run per file extension." />

    <TextBlock Text="Prefix" Margin="0,0,0,4" />
    <TextBox x:Name="PrefixBox" TextChanged="OnInputChanged" Margin="0,0,0,12" />

    <TextBlock x:Name="NameLabel" Text="Custom name" Margin="0,0,0,4" />
    <TextBox x:Name="NameBox" TextChanged="OnInputChanged" Margin="0,0,0,6" />
    <CheckBox x:Name="NumberBox" Content="Number the files instead" IsChecked="True"
              Checked="OnNumberingChanged" Unchecked="OnNumberingChanged" Margin="0,0,0,12" />

    <TextBlock Text="Suffix" Margin="0,0,0,4" />
    <TextBox x:Name="SuffixBox" TextChanged="OnInputChanged" Margin="0,0,0,14" />

    <Border Style="{StaticResource Panel.Card}" Padding="10,8">
      <StackPanel>
        <TextBlock Style="{StaticResource Text.Muted}" Text="Preview" Margin="0,0,0,3" />
        <TextBlock x:Name="PreviewText" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="Rename" IsDefault="True" Style="{StaticResource Button.Primary}"
              Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
