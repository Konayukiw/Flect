<Window x:Class="Optimizer.Gui.OcrNotice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Optimizer.Main"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Text.Heading}" Text="{loc:T dialog.ocr.title}" />
    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="{loc:T dialog.ocr.body}" />

    <TextBlock Text="{loc:T dialog.ocr.installedHere}" Margin="0,0,0,4" />
    <Border Style="{StaticResource Panel.Card}" Padding="12,10">
      <TextBlock x:Name="LanguagesText" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
               Text="{loc:T dialog.ocr.howto}" />

    <CheckBox x:Name="SuppressBox" Content="{loc:T dialog.ocr.suppress}" Margin="0,16,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{loc:T common.ok}" IsDefault="True"
              Style="{StaticResource Button.Primary}" Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
