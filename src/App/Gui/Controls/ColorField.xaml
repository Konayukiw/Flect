<UserControl x:Class="Optimizer.Gui.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left">

  <Grid>
    <Border x:Name="Trigger" Cursor="Hand" CornerRadius="5" Padding="7,5"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            MouseLeftButtonUp="OnTriggerClick">
      <StackPanel Orientation="Horizontal">
        <Border x:Name="Swatch" Width="18" Height="18" CornerRadius="3" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border}" />
        <TextBlock x:Name="HexLabel" Margin="8,0,2,0" VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="12" />
      </StackPanel>
    </Border>

    <Popup x:Name="Pop" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
           PlacementTarget="{Binding ElementName=Trigger}" VerticalOffset="4"
           PopupAnimation="Fade" Focusable="True">
      <Border Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="6" Padding="12" Margin="0,0,10,10">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </Border.Effect>

        <StackPanel Width="216">
          <Border x:Name="Field" Height="132" CornerRadius="4" ClipToBounds="True"
                  BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                  Cursor="Cross"
                  MouseLeftButtonDown="OnFieldDown" MouseMove="OnFieldMove"
                  MouseLeftButtonUp="OnFieldUp">
            <Grid>
              <Rectangle x:Name="HueLayer" />
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Rectangle>
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#FF000000" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <Canvas x:Name="FieldOverlay" IsHitTestVisible="False">
                <Ellipse x:Name="Marker" Width="12" Height="12" StrokeThickness="2"
                         Stroke="#FFFFFFFF">
                  <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.7" Color="Black" />
                  </Ellipse.Effect>
                </Ellipse>
              </Canvas>
            </Grid>
          </Border>

          <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Margin="0,10,0,0"
                  IsMoveToPointEnabled="True" ValueChanged="OnHueChanged" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="Preview" Height="28" CornerRadius="4"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
            <TextBox Grid.Column="1" x:Name="HexBox" Margin="8,0,0,0"
                     FontFamily="{DynamicResource Font.Mono}"
                     KeyDown="OnHexKey" LostFocus="OnHexCommitted" />
          </Grid>

          <ItemsControl x:Name="Swatches" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="22" Height="22" Margin="0,0,4,4" CornerRadius="3" Cursor="Hand"
                        Background="{Binding Brush}" ToolTip="{Binding Hex}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        MouseLeftButtonUp="OnSwatchClick" Tag="{Binding Hex}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
