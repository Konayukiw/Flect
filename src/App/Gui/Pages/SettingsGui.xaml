<Window x:Class="Optimizer.Gui.Pages.SettingsGui"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Optimizer.Main.Localization"
        xmlns:pages="clr-namespace:Optimizer.Gui.Pages"
        Width="940" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">

  <Window.Resources>
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="8,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Row" CornerRadius="5" Background="Transparent" Padding="10,8">
              <Grid>
                <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                        Margin="-4,2,0,2" Opacity="0"
                        Background="{DynamicResource Brush.Accent}" />
                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background"
                        Value="{DynamicResource Brush.Hover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Row" Property="Background"
                        Value="{DynamicResource Brush.Hover}" />
                <Setter TargetName="Marker" Property="Opacity" Value="1" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,20,18,16">
          <TextBlock Text="Flect" FontSize="19" FontWeight="SemiBold" />
          <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" IsChecked="True"
                       Content="{loc:T settings.nav.general}" Checked="OnNavChanged" Tag="0" />
          <RadioButton x:Name="NavFolder" Style="{StaticResource NavItem}"
                       Content="{loc:T settings.nav.folder}" Checked="OnNavChanged" Tag="1" />
          <RadioButton x:Name="NavVideo" Style="{StaticResource NavItem}"
                       Content="{loc:T settings.nav.video}" Checked="OnNavChanged" Tag="2" />
          <RadioButton x:Name="NavImage" Style="{StaticResource NavItem}"
                       Content="{loc:T settings.nav.image}" Checked="OnNavChanged" Tag="3" />
          <RadioButton x:Name="NavText" Style="{StaticResource NavItem}"
                       Content="{loc:T settings.nav.text}" Checked="OnNavChanged" Tag="4" />
          <RadioButton x:Name="NavOcr" Style="{StaticResource NavItem}"
                       Content="{loc:T settings.nav.ocr}" Checked="OnNavChanged" Tag="5" />
        </StackPanel>

        <Button Grid.Row="2" Margin="16,0,16,18" HorizontalAlignment="Stretch"
                Style="{StaticResource DangerButton}"
                Content="{loc:T settings.reset}" Click="OnReset" />
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="PageTitle" Grid.Row="0" Margin="26,22,26,12"
                 FontSize="20" FontWeight="SemiBold" />

      <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Padding="26,0,20,10">
        <Grid x:Name="PageHost">
          <pages:General x:Name="PageGeneral" />
          <pages:Folder x:Name="PageFolder" Visibility="Collapsed" />
          <pages:Video x:Name="PageVideo" Visibility="Collapsed" />
          <pages:Image x:Name="PageImage" Visibility="Collapsed" />
          <pages:Text x:Name="PageText" Visibility="Collapsed" />
          <pages:Ocr x:Name="PageOcr" Visibility="Collapsed" />
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
              Background="{DynamicResource Brush.Surface}" Padding="26,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:T common.cancel}" Click="OnCancel" IsCancel="True" />
          <Button x:Name="ApplyButton" Content="{loc:T common.apply}" Click="OnApply"
                  Margin="8,0,0,0" />
          <Button Content="{loc:T common.ok}" Click="OnAccept" IsDefault="True" Margin="8,0,0,0"
                  Style="{StaticResource Button.Primary}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
