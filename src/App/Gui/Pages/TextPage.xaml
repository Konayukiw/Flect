<UserControl x:Class="Optimizer.Gui.TextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Optimizer.Main">

  <StackPanel>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.text.sjis}" />
        <TextBlock Style="{StaticResource Settings.Hint}"
                   Text="{loc:T settings.text.sjis.hint}" />

        <RadioButton x:Name="SjisReplaceBox" GroupName="Sjis" Checked="OnSjisModeChanged"
                     Content="{loc:T settings.text.sjis.replace}" />
        <RadioButton x:Name="SjisSubstituteBox" GroupName="Sjis" Checked="OnSjisModeChanged"
                     Content="{loc:T settings.text.sjis.substitute}" />

        <Grid Margin="26,4,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="70" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="SubstituteLabel" Margin="0,0,10,0"
                     Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.text.sjis.character}" />
          <TextBox Grid.Column="1" x:Name="SubstituteBox" MaxLength="1"
                   Style="{StaticResource Settings.Field}" />
        </Grid>

        <RadioButton x:Name="SjisFailBox" GroupName="Sjis" Checked="OnSjisModeChanged"
                     Content="{loc:T settings.text.sjis.fail}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.text.json}" />

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.text.json.comparison}" />
          <ComboBox Grid.Column="1" x:Name="ComparisonBox" />
        </Grid>

        <CheckBox x:Name="DescendingBox" Content="{loc:T settings.text.json.descending}" />
        <CheckBox x:Name="RecursiveBox" Content="{loc:T settings.text.json.recursive}" />
        <CheckBox x:Name="SortArraysBox" Content="{loc:T settings.text.json.arrays}" />

        <Border Style="{StaticResource Settings.Separator}" />

        <TextBlock Style="{StaticResource Settings.Label}" Margin="0,0,0,5"
                   Text="{loc:T settings.text.json.pinned}" />
        <TextBox x:Name="PinnedKeysBox" Style="{StaticResource Settings.Patterns}"
                 HorizontalAlignment="Left" Width="300" />
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,7,0,0"
                   Text="{loc:T settings.text.json.pinned.hint}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.text.toTxt}" />
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0"
                   Text="{loc:T settings.text.toTxt.hint}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
