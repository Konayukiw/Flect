<UserControl x:Class="Optimizer.Gui.Pages.Image"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Optimizer.Main.Localization"
             xmlns:gui="clr-namespace:Optimizer.Gui.Controls">

  <StackPanel>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{loc:T settings.presets}" />
        <TextBlock Style="{StaticResource Settings.Hint}" Text="{loc:T settings.presets.hint}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Margin="0,0,0,8" Text="{loc:T settings.presets.resize}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="ResizeABox" Style="{StaticResource Settings.Field}" Width="90" />
            <TextBox x:Name="ResizeBBox" Style="{StaticResource Settings.Field}" Width="90"
                     Margin="8,0,0,0" />
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Margin="0,0,0,8" Text="{loc:T settings.presets.compress}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="CompressABox" Style="{StaticResource Settings.Field}" Width="100" />
            <TextBox x:Name="CompressBBox" Style="{StaticResource Settings.Field}" Width="100"
                     Margin="8,0,0,0" />
            <TextBox x:Name="CompressCBox" Style="{StaticResource Settings.Field}" Width="100"
                     Margin="8,0,0,0" />
            <TextBox x:Name="CompressDBox" Style="{StaticResource Settings.Field}" Width="100"
                     Margin="8,0,0,0" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.presets.rotate}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="RotateABox" Style="{StaticResource Settings.Field}" Width="90" />
            <TextBox x:Name="RotateBBox" Style="{StaticResource Settings.Field}" Width="90"
                     Margin="8,0,0,0" />
            <TextBox x:Name="RotateCBox" Style="{StaticResource Settings.Field}" Width="90"
                     Margin="8,0,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.image.compression}" />

        <CheckBox x:Name="WebpFallbackBox" Content="{loc:T settings.image.webpFallback}" />
        <TextBlock Style="{StaticResource Settings.SubHint}" Margin="50,4,0,10"
                   Text="{loc:T settings.image.webpFallback.hint}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.image.webpQuality}" />
          <Slider Grid.Column="1" x:Name="WebpQualitySlider" Minimum="10" Maximum="100"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="OnWebpQualityChanged" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" x:Name="WebpQualityLabel" Margin="12,0,0,0" MinWidth="30"
                     Style="{StaticResource Settings.Label}" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.image.background}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.image.background.color}" />
          <gui:ColorField Grid.Row="0" Grid.Column="1" x:Name="KeyColorField" Margin="0,0,0,10" />

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.image.background.tolerance}" />
          <Slider Grid.Row="1" Grid.Column="1" x:Name="ToleranceSlider" Minimum="0" Maximum="100"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="OnToleranceChanged" VerticalAlignment="Center" />
          <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ToleranceLabel" Margin="12,0,0,0"
                     MinWidth="34" Style="{StaticResource Settings.Label}" />
        </Grid>

        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,12,0,0"
                   Text="{loc:T settings.image.background.hint}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.image.metadata}" />

        <CheckBox x:Name="MetaExifBox" Content="{loc:T settings.image.metadata.exif}" />
        <CheckBox x:Name="MetaGpsBox" Content="{loc:T settings.image.metadata.gps}" />
        <CheckBox x:Name="MetaCommentsBox" Content="{loc:T settings.image.metadata.comments}" />
        <CheckBox x:Name="MetaProfileBox" Content="{loc:T settings.image.metadata.profile}" />
        <TextBlock Style="{StaticResource Settings.SubHint}" Margin="50,4,0,8"
                   Text="{loc:T settings.image.metadata.profileHint}" />
        <CheckBox x:Name="MetaOrientationBox"
                  Content="{loc:T settings.image.metadata.orientation}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
