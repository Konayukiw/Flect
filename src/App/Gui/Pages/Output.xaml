<UserControl x:Class="Optimizer.Gui.Pages.Output"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Optimizer.Main.Localization">
  <StackPanel>
    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.output.title}" />
        <TextBlock Style="{StaticResource Settings.Hint}"
                   Text="{loc:T settings.output.hint}" />
        <TextBlock Style="{StaticResource Settings.Hint}"
                   Text="{loc:T settings.output.example}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="FeatureBox" Grid.Column="0" Margin="0,0,8,0" />
          <Button x:Name="AddButton" Grid.Column="1" Content="{loc:T settings.output.add}"
                  Click="OnAdd" MinWidth="0" Padding="14,6" />
        </Grid>

        <ItemsControl x:Name="RuleList" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Margin="0,0,8,0"
                           Style="{StaticResource Settings.Label}"
                           TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1" Margin="0,0,8,0"
                         Style="{StaticResource Settings.Field}"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2" Content="{loc:T common.browse}" Margin="0,0,8,0"
                        MinWidth="0" Padding="14,6" Click="OnBrowse" />
                <Button Grid.Column="3" Content="{loc:T common.default}"
                        MinWidth="0" Padding="14,6" Click="OnDefault" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
