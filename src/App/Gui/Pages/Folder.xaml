<UserControl x:Class="Optimizer.Gui.Pages.Folder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Optimizer.Main.Localization"
             xmlns:gui="clr-namespace:Optimizer.Gui.Pages">

  <StackPanel>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.duplicates}" />

        <TextBlock Style="{StaticResource Settings.Label}" Margin="0,0,0,6"
                   Text="{loc:T settings.folder.dup.strictness}" />
        <RadioButton x:Name="StrictSizeBox" GroupName="Strictness"
                     Content="{loc:T settings.folder.dup.sizeOnly}" />
        <RadioButton x:Name="StrictHeadBox" GroupName="Strictness"
                     Content="{loc:T settings.folder.dup.headHash}" />
        <RadioButton x:Name="StrictFullBox" GroupName="Strictness"
                     Content="{loc:T settings.folder.dup.fullContent}" />

        <Border Style="{StaticResource Settings.Separator}" />

        <TextBlock Style="{StaticResource Settings.Label}" Margin="0,0,0,6"
                   Text="{loc:T settings.folder.dup.extra}" />
        <CheckBox x:Name="MatchNameBox" Content="{loc:T settings.folder.dup.matchName}" />
        <CheckBox x:Name="MatchTimeBox" Content="{loc:T settings.folder.dup.matchTime}" />
        <CheckBox x:Name="IgnoreEmptyBox" Content="{loc:T settings.folder.dup.ignoreEmpty}" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}" Margin="0,0,12,0"
                     Text="{loc:T settings.folder.dup.minimum}" />
          <TextBox Grid.Column="1" x:Name="MinimumBytesBox"
                   Style="{StaticResource Settings.Field}" />
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}" Margin="0,0,12,0"
                     Text="{loc:T settings.folder.dup.keep}" />
          <ComboBox Grid.Column="1" x:Name="KeepBox" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.delete}" />
        <RadioButton x:Name="RecycleBox" GroupName="Deletion" Checked="OnDeleteModeChanged"
                     Content="{loc:T settings.folder.delete.recycle}" />
        <RadioButton x:Name="PermanentBox" GroupName="Deletion" Checked="OnDeleteModeChanged"
                     Content="{loc:T settings.folder.delete.permanent}" />
        <TextBlock x:Name="PermanentWarning" Style="{StaticResource Settings.SubHint}"
                   Margin="26,6,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource Brush.Danger}"
                   Text="{loc:T settings.folder.delete.warning}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.scan}" />
        <TextBlock Style="{StaticResource Settings.Hint}"
                   Text="{loc:T settings.folder.scan.hint}" />
        <gui:ExclusionEditor x:Name="ScanExclusions" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.rename}" />

        <CheckBox x:Name="NumberingBox" Content="{loc:T settings.folder.rename.numbering}" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}" Margin="0,0,10,0"
                     Text="{loc:T settings.folder.rename.digits}" />
          <TextBox Grid.Column="1" x:Name="DigitsBox" Style="{StaticResource Settings.Field}" />
          <TextBlock Grid.Column="2" Style="{StaticResource Settings.Label}" Margin="18,0,10,0"
                     Text="{loc:T settings.folder.rename.start}" />
          <TextBox Grid.Column="3" x:Name="StartNumberBox"
                   Style="{StaticResource Settings.Field}" />
        </Grid>
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,7,0,0"
                   Text="{loc:T settings.folder.rename.digitsHint}" />

        <CheckBox x:Name="DryRunBox" Content="{loc:T settings.folder.rename.dryRun}" />

        <Border Style="{StaticResource Settings.Separator}" />
        <gui:ExclusionEditor x:Name="RenameExclusions" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.empty}" />
        <TextBlock Style="{StaticResource Settings.Hint}"
                   Text="{loc:T settings.folder.empty.hint}" />
        <CheckBox x:Name="EmptyZeroBox" Content="{loc:T settings.folder.empty.zero}" />
        <CheckBox x:Name="EmptyDesktopIniBox" Content="{loc:T settings.folder.empty.desktopIni}" />
        <CheckBox x:Name="EmptyThumbsBox" Content="{loc:T settings.folder.empty.thumbs}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.tree}" />
        <CheckBox x:Name="FoldersOnlyBox" Margin="0,0,0,12"
                  Content="{loc:T settings.folder.tree.foldersOnly}" />
        <gui:ExclusionEditor x:Name="TreeExclusions" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.analyze}" />

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}" Margin="0,0,12,0"
                     Text="{loc:T settings.folder.analyze.format}" />
          <ComboBox Grid.Column="1" x:Name="ReportFormatBox" />
        </Grid>

        <gui:ExclusionEditor x:Name="AnalyzeExclusions" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.folder.compress}" />

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}" Margin="0,0,12,0"
                     Text="{loc:T settings.folder.compress.format}" />
          <ComboBox Grid.Column="1" x:Name="CompressFormatBox" />
        </Grid>

        <TextBlock Style="{StaticResource Settings.Hint}"
                   Text="{loc:T settings.folder.compress.hint}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
