<Window x:Class="Optimizer.Gui.AnalyzeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="700" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,20,0,6" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.Heading}" Text="Analyze" />
      <TextBlock x:Name="RootsText" Style="{StaticResource Text.Muted}"
                 TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />

      <ItemsControl x:Name="Tiles">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Panel.Card}" Margin="0,0,8,0" Padding="12,10">
              <StackPanel>
                <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}"
                           Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
      <StackPanel>

        <TextBlock Style="{StaticResource Section}" Text="Largest files" />
        <ItemsControl x:Name="LargestList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Size}" Style="{StaticResource Mono}"
                           TextAlignment="Right" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Section}" Text="File types" />
        <ItemsControl x:Name="TypeList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Extension}" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" HorizontalAlignment="Left" Height="10" CornerRadius="2"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        Width="{Binding BarWidth}"
                        Background="{DynamicResource Brush.Accent}" />
                <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Mono}"
                           TextAlignment="Right" Margin="0,0,12,0" />
                <TextBlock Grid.Column="3" Text="{Binding Share}" Style="{StaticResource Mono}"
                           TextAlignment="Right" Margin="0,0,12,0"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Grid.Column="4" Text="{Binding Count}"
                           Style="{StaticResource Text.Muted}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource Section}" Text="Duplicates" />
        <TextBlock x:Name="DuplicateText" FontSize="12" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource Section}" Text="Empty folders" />
        <TextBlock x:Name="EmptyText" FontSize="12" Margin="0,0,0,4" />
        <ItemsControl x:Name="EmptyList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontSize="12" Margin="0,1"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Brush.TextMuted}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
