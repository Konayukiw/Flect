<Window x:Class="Optimizer.Gui.PixelsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Text.Heading}" Text="Resize" />
    <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="Leave one box empty to derive it from the other." />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Width (px)" Margin="0,0,0,4" />
        <TextBox x:Name="WidthBox" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Height (px)" Margin="0,0,0,4" />
        <TextBox x:Name="HeightBox" />
      </StackPanel>
    </Grid>

    <CheckBox x:Name="KeepAspectBox" IsChecked="True" Margin="0,14,0,0"
              Content="Keep aspect ratio" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="Resize" IsDefault="True" Style="{StaticResource Button.Primary}"
              Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
