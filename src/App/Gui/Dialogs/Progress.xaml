<Window x:Class="Optimizer.Gui.Dialogs.Progress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="clr-namespace:Optimizer.Gui.Dialogs"
        Width="580" Height="300" MinWidth="420" MinHeight="200"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

  <Window.Resources>
    <Style x:Key="LogRow" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="{x:Static gui:LogSeverity.Warning}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="{x:Static gui:LogSeverity.Error}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource Text.Heading}" />

    <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource Text.Muted}"
               TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

    <ProgressBar x:Name="Bar" Grid.Row="2" IsIndeterminate="True" Margin="0,0,0,12" />

    <Border Grid.Row="3" Style="{StaticResource Panel.Card}" Padding="10,8"
            x:Name="LogPanel" Visibility="Collapsed">
      <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="LogList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Message}" Style="{StaticResource LogRow}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="ActionButton" Content="Cancel" Click="OnActionClick" />
    </StackPanel>
  </Grid>
</Window>
