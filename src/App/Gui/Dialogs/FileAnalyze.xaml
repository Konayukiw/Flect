<Window x:Class="Optimizer.Gui.Dialogs.FileAnalyzeWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Optimizer.Main.Localization"
        Width="760" Height="720" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.Heading}" Text="{loc:T dialog.fileAnalyze.title}" />
      <TextBlock x:Name="PathText" Style="{StaticResource Text.Muted}"
                 TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
      <ItemsControl x:Name="AlertList" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,2"
                       Foreground="{DynamicResource Brush.Danger}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ItemsControl x:Name="OverviewList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="168" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                           TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:T dialog.fileAnalyze.hash}" Style="{StaticResource Text.Muted}" />
          <TextBlock x:Name="HashText" Grid.Column="1" FontSize="12"
                     FontFamily="{DynamicResource Font.Mono}" TextWrapping="Wrap" />
        </Grid>

        <ItemsControl x:Name="SectionList" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Section}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="168" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{loc:T dialog.analyze.save}" Click="OnSave" />
    </StackPanel>
  </Grid>
</Window>
