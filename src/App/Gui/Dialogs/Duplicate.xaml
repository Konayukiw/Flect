<Window x:Class="Optimizer.Gui.Dialogs.Duplicate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Optimizer.Main.Localization"
        Width="760" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource Text.Heading}" Text="{loc:T menu.folder.removeDuplicate}" />
      <TextBlock x:Name="FoundText" Style="{StaticResource Text.Muted}" Margin="0,0,0,14" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,12">
      <StackPanel>
        <RadioButton x:Name="KeepOldestOption" GroupName="Mode" IsChecked="True"
                     Content="{loc:T dialog.duplicate.keepOldest}" Checked="OnModeChanged" />
        <RadioButton x:Name="KeepNewestOption" GroupName="Mode"
                     Content="{loc:T dialog.duplicate.keepNewest}" Checked="OnModeChanged" />
        <RadioButton x:Name="DeleteAllOption" GroupName="Mode"
                     Content="{loc:T dialog.duplicate.deleteAll}" Checked="OnModeChanged" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Padding="4">
      <ListBox x:Name="RowList" BorderThickness="0" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Tag" Grid.Column="0" Text="{Binding Note}" FontSize="11"
                         Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
              <TextBlock x:Name="Body" Grid.Column="1" Text="{Binding Text}" FontSize="12"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource Brush.Text}" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter TargetName="Body" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Body" Property="Margin" Value="0,8,0,2" />
                <Setter TargetName="Body" Property="Foreground"
                        Value="{DynamicResource Brush.TextMuted}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsRemoving}" Value="True">
                <Setter TargetName="Tag" Property="Foreground"
                        Value="{DynamicResource Brush.Danger}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="PlanText" VerticalAlignment="Center"
                 Style="{StaticResource Text.Muted}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:T common.cancel}" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
        <Button x:Name="AcceptButton" IsDefault="True"
                Style="{StaticResource Button.Primary}" Click="OnAccept" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
