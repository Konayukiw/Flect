<Window x:Class="Optimizer.Gui.Dialogs.TargetBytes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Optimizer.Main.Localization"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <StackPanel Margin="18">
    <TextBlock Style="{StaticResource Text.Heading}" Text="{loc:T menu.image.compress}" />
    <TextBlock x:Name="HintText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
               Margin="0,0,0,14" />

    <TextBlock Text="{loc:T dialog.target.label}" Margin="0,0,0,4" />
    <TextBox x:Name="SizeBox" TextChanged="OnInputChanged" />
    <TextBlock x:Name="EchoText" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{loc:T common.cancel}" IsCancel="True" Margin="0,0,8,0" Click="OnCancel" />
      <Button Content="{loc:T dialog.target.action}" IsDefault="True" Style="{StaticResource Button.Primary}"
              Click="OnAccept" />
    </StackPanel>
  </StackPanel>
</Window>
