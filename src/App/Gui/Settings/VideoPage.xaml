<UserControl x:Class="Optimizer.Gui.VideoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Optimizer.Main"
             xmlns:gui="clr-namespace:Optimizer.Gui">

  <StackPanel>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{loc:T settings.presets}" />
        <TextBlock Style="{StaticResource Settings.Hint}" Text="{loc:T settings.presets.hint}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Margin="0,0,0,8" Text="{loc:T settings.presets.resize}" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="ResizeABox" Style="{StaticResource Settings.Field}" Width="90" />
            <TextBox x:Name="ResizeBBox" Style="{StaticResource Settings.Field}" Width="90"
                     Margin="8,0,0,0" />
          </StackPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Margin="0,0,0,8" Text="{loc:T settings.presets.compress}" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,0,0,3" FontSize="11"
                         Text="{loc:T menu.video.compress.discord}" />
              <TextBox x:Name="DiscordBox" Style="{StaticResource Settings.Field}" Width="100" />
            </StackPanel>
            <TextBox x:Name="CompressABox" Style="{StaticResource Settings.Field}" Width="100"
                     Margin="8,17,0,0" VerticalAlignment="Top" />
            <TextBox x:Name="CompressBBox" Style="{StaticResource Settings.Field}" Width="100"
                     Margin="8,17,0,0" VerticalAlignment="Top" />
            <TextBox x:Name="CompressCBox" Style="{StaticResource Settings.Field}" Width="100"
                     Margin="8,17,0,0" VerticalAlignment="Top" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.presets.rotate}" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="RotateABox" Style="{StaticResource Settings.Field}" Width="90" />
            <TextBox x:Name="RotateBBox" Style="{StaticResource Settings.Field}" Width="90"
                     Margin="8,0,0,0" />
            <TextBox x:Name="RotateCBox" Style="{StaticResource Settings.Field}" Width="90"
                     Margin="8,0,0,0" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.video.encoding}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.video.codec}" />
          <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CodecBox" Margin="0,0,0,8" />

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.video.hardware}" />
          <ComboBox Grid.Row="1" Grid.Column="1" x:Name="HardwareBox" />
        </Grid>

        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,10,0,0"
                   Text="{loc:T settings.video.hardware.hint}" />

        <Border Style="{StaticResource Settings.Separator}" />

        <TextBlock Style="{StaticResource Settings.Label}" Margin="0,0,0,8"
                   Text="{loc:T settings.video.priority}" />
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="PrioritySpeedBox" GroupName="Priority" Margin="0,0,22,0"
                       Content="{loc:T settings.video.priority.speed}" />
          <RadioButton x:Name="PriorityBalancedBox" GroupName="Priority" Margin="0,0,22,0"
                       Content="{loc:T settings.video.priority.balanced}" />
          <RadioButton x:Name="PriorityQualityBox" GroupName="Priority"
                       Content="{loc:T settings.video.priority.quality}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,8,0,0"
                   Text="{loc:T settings.video.priority.hint}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.video.gif}" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.video.gif.fps}" />
          <TextBox Grid.Row="0" Grid.Column="1" x:Name="GifFpsBox" Width="90"
                   HorizontalAlignment="Left" Margin="0,0,0,8"
                   Style="{StaticResource Settings.Field}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.video.gif.width}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="GifWidthBox" Width="90"
                   HorizontalAlignment="Left" Margin="0,0,0,8"
                   Style="{StaticResource Settings.Field}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.video.gif.dither}" />
          <ComboBox Grid.Row="2" Grid.Column="1" x:Name="GifDitherBox" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.video.rotate}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.video.rotate.fill}" />
          <gui:ColorField Grid.Column="1" x:Name="FillColorField" />
        </Grid>
        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,10,0,0"
                   Text="{loc:T settings.video.rotate.fillHint}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
