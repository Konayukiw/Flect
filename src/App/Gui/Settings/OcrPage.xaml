<UserControl x:Class="Optimizer.Gui.OcrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Optimizer.Main">

  <StackPanel>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.ocr.language}" />

        <ComboBox x:Name="LanguageBox" Width="320" HorizontalAlignment="Left" />

        <TextBlock x:Name="InstalledText" Style="{StaticResource Settings.Hint}"
                   Margin="0,10,0,0" />

        <Border Style="{StaticResource Settings.Separator}" />

        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="InstallBox" Width="230" />
          <Button Content="{loc:T settings.ocr.language.install}" Click="OnInstall"
                  Margin="8,0,0,0" MinWidth="0" Padding="14,6" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.ocr.output}" />

        <RadioButton x:Name="OutputFileBox" GroupName="OcrOutput" Checked="OnOutputChanged"
                     Content="{loc:T settings.ocr.output.file}" />
        <RadioButton x:Name="OutputClipboardBox" GroupName="OcrOutput" Checked="OnOutputChanged"
                     Content="{loc:T settings.ocr.output.clipboard}" />
        <RadioButton x:Name="OutputShowBox" GroupName="OcrOutput" Checked="OnOutputChanged"
                     Content="{loc:T settings.ocr.output.show}" />

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="EncodingLabel"
                     Style="{StaticResource Settings.Label}"
                     Text="{loc:T settings.ocr.encoding}" />
          <ComboBox Grid.Column="1" x:Name="EncodingBox" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Settings.Section}">
      <StackPanel>
        <TextBlock Style="{StaticResource Settings.SectionTitle}"
                   Text="{loc:T settings.ocr.notice}" />
        <CheckBox x:Name="SuppressNoticeBox" Content="{loc:T settings.ocr.notice.suppress}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
