<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <RootNamespace>Flect</RootNamespace>
    <AssemblyName>$(BrandAppExeName)</AssemblyName>
    <Product>$(BrandName)</Product>
    <AssemblyTitle>$(BrandName)</AssemblyTitle>
    <AssemblyVersion>$(BrandDisplayVersion)</AssemblyVersion>
    <FileVersion>$(BrandDisplayVersion)</FileVersion>
    <InformationalVersion>$(BrandDisplayVersion)</InformationalVersion>
    <Version>$(BrandDisplayVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Flect" />
    <Using Include="Flect.Display" />
    <Using Include="Flect.Files" />
    <Using Include="Flect.External" />
    <Using Include="Flect.Dispatch" />
    <Using Include="Flect.Settings" />
    <Using Include="Flect.Settings.Settings" Alias="Preferences" />
    <Using Include="Flect.Inspect" />
    <Using Include="Flect.Folder" />
    <Using Include="Flect.Folder.Analysis" />
    <Using Include="Flect.Folder.Duplicate" />
    <Using Include="Flect.Folder.Rename" />
    <Using Include="Flect.Folder.Empty" />
    <Using Include="Flect.Folder.Tree" />
    <Using Include="Flect.Folder.Compress" />
    <Using Include="Flect.Video.Compress" />
    <Using Include="Flect.Video.Trim" />
    <Using Include="Flect.Video.Thumbnail" />
    <Using Include="Flect.Inspect.Detail" />
    <Using Include="Flect.Inspect.Report" />
    <Using Include="Flect.Inspect.Suggest" />
    <Using Include="Flect.Inspect.Window" />
    <Using Include="Flect.Settings.General" />
    <Using Include="Flect.Settings.Output" />
    <Using Include="Flect.Settings.Theme" />
    <Using Include="Flect.Text.Json" />
    <Using Include="Flect.Archive" />
    <Using Include="Flect.Image" />
    <Using Include="Flect.Video" />
    <Using Include="Flect.Audio" />
    <Using Include="Flect.Subtitles" />
    <Using Include="Flect.Ocr" />
    <Using Include="Flect.Pdf" />
    <Using Include="Flect.Text" />
    <Using Include="Flect.Decompile" />
    <Using Include="Flect.Update" />
    <Using Include="Flect.I18n" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Evals" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)Assets\flect.ico')">
    <ApplicationIcon>Assets\flect.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Assets\flect.ico')">
    <Resource Include="Assets\flect.ico" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Assets\Fonts\Inter.ttf')">
    <Resource Include="Assets\Fonts\Inter.ttf" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Assets\Fonts\Higure.ttf')">
    <Resource Include="Assets\Fonts\Higure.ttf" />
  </ItemGroup>

  <Target Name="WarnMissingAppIcon" BeforeTargets="BeforeBuild"
          Condition="!Exists('$(MSBuildThisFileDirectory)Assets\flect.ico')">
    <Warning Text="Assets\flect.ico is missing - building without an application icon." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="..\Preview\Extensions.inc" LogicalName="Flect.Preview.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
    <PackageReference Include="PDFtoImage" Version="5.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <PackageReference Include="UTF.Unknown" Version="2.6.0" />
  </ItemGroup>

  <Target Name="TrimForeignSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_ForeignSymbols Include="$(PublishDir)**\*.pdb"
                       Exclude="$(PublishDir)$(AssemblyName).pdb" />
    </ItemGroup>
    <Delete Files="@(_ForeignSymbols)" />
  </Target>

  <ItemGroup>
    <Compile Include="$(BrandBuildDir)i18n\Strings.g.cs" Link="I18n\Strings.g.cs" />
  </ItemGroup>

  <Target Name="GenerateStringsSource" BeforeTargets="BeforeBuild;CoreCompile"
          Inputs="$(StringsInputs)"
          Outputs="$(BrandBuildDir)i18n\Strings.g.cs">
    <Exec Command="node &quot;$(StringsGenerator)&quot; app &quot;$(BrandBuildDir)i18n\Strings.g.cs&quot;" />
  </Target>

  <Target Name="GenerateBrandingSource" BeforeTargets="BeforeCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <_BrandLine Include="// &lt;auto-generated /&gt; Source of truth: Directory.Build.props" />
      <_BrandLine Include="namespace $(RootNamespace)%3B" />
      <_BrandLine Include="internal static class Branding" />
      <_BrandLine Include="{" />
      <_BrandLine Include="    public const string Name = &quot;$(BrandName)&quot;%3B" />
      <_BrandLine Include="    public const string Version = &quot;$(BrandDisplayVersion)&quot;%3B" />
      <_BrandLine Include="    public const string PreviewClsid = &quot;$(BrandPreviewClsid)&quot;%3B" />
      <_BrandLine Include="    public const string PreviewHtmlClsid = &quot;$(BrandPreviewHtmlClsid)&quot;%3B" />
      <_BrandLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Branding.g.cs"
                      Lines="@(_BrandLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="utf-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Branding.g.cs" />
    </ItemGroup>
  </Target>

</Project>
