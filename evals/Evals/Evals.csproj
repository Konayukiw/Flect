<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <RootNamespace>Evals</RootNamespace>
    <AssemblyName>Evals</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Xunit" />
    <Using Include="Flect" />
    <Using Include="Flect.Display" />
    <Using Include="Flect.Files" />
    <Using Include="Flect.External" />
    <Using Include="Flect.Dispatch" />
    <Using Include="Flect.Settings" />
    <Using Include="Flect.Settings.Settings" Alias="Preferences" />
    <Using Include="Flect.Inspect" />
    <Using Include="Flect.Folder" />
    <Using Include="Flect.Folder.Analysis" />
    <Using Include="Flect.Folder.Duplicate" />
    <Using Include="Flect.Folder.Rename" />
    <Using Include="Flect.Folder.Empty" />
    <Using Include="Flect.Folder.Tree" />
    <Using Include="Flect.Folder.Compress" />
    <Using Include="Flect.Video.Compress" />
    <Using Include="Flect.Video.Trim" />
    <Using Include="Flect.Video.Thumbnail" />
    <Using Include="Flect.Inspect.Detail" />
    <Using Include="Flect.Inspect.Report" />
    <Using Include="Flect.Inspect.Suggest" />
    <Using Include="Flect.Inspect.Window" />
    <Using Include="Flect.Settings.General" />
    <Using Include="Flect.Settings.Output" />
    <Using Include="Flect.Settings.Theme" />
    <Using Include="Flect.Text.Json" />
    <Using Include="Flect.Archive" />
    <Using Include="Flect.Image" />
    <Using Include="Flect.Video" />
    <Using Include="Flect.Audio" />
    <Using Include="Flect.Subtitles" />
    <Using Include="Flect.Ocr" />
    <Using Include="Flect.Pdf" />
    <Using Include="Flect.Text" />
    <Using Include="Flect.Decompile" />
    <Using Include="Flect.Update" />
    <Using Include="Flect.I18n" />
    <Using Include="Evals.Harness" />
    <Using Include="Evals.Harness.Harness" Alias="Rig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App\App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)dependencies\*" Link="deps\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RepoRoot)deps\*.py" Link="deps\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
