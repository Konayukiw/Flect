<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <RootNamespace>Evals</RootNamespace>
    <AssemblyName>Evals</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Xunit" />
    <Using Include="Optimizer" />
    <Using Include="Optimizer.Main.Common" />
    <Using Include="Optimizer.Main.Config" />
    <Using Include="Optimizer.Main.Process" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App\App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)dependencies\*" Link="deps\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RepoRoot)deps\*.py" Link="deps\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\fixtures\**\*" Link="fixtures\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
